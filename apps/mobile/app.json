{
  "expo": {
    "name": "QSale",
    "slug": "qsale",
    "scheme": "qsale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/qsale.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.qsale.app"
    },
    "android": {
      "package": "pe.qsale.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/qsale.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "QSale usa la cámara para leer códigos QR de invitación.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "QSale usa tu ubicación solo cuando la solicitas, para ayudar a elegir un punto de encuentro."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "QSale usa tu calendario solo cuando eliges agregar un plan confirmado."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QSale usa tus fotos solo para la foto de perfil que eliges.",
          "cameraPermission": "QSale usa la cámara para tomar tu foto de perfil y leer códigos QR de invitación."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fdfa1697-00a0-4769-a894-a9520abbb061"
      }
    },
    "owner": "gonzagl05",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fdfa1697-00a0-4769-a894-a9520abbb061"
    }
  }
}
